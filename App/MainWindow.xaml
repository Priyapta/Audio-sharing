<Window x:Class="MultiHeadsetAudioSharing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-Headset Audio Sharing" Width="1100" Height="800"
        MinWidth="720" MinHeight="560" Background="#F3F6FA"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Multi-Headset Audio Sharing" FontSize="26" FontWeight="SemiBold" Foreground="#183B56" />
            <TextBlock Text="Bagikan audio dari satu output Windows ke 2–5 perangkat pendengar." Margin="0,6,0,0" Foreground="#526577" />
        </StackPanel>
        <GroupBox Grid.Row="1" Header="1. Pilih sumber audio" Background="White" Margin="0,0,0,14">
            <StackPanel>
                <ComboBox x:Name="SourceSelector" ItemsSource="{Binding SourceDevices}" DisplayMemberPath="Name"
                          SelectedValuePath="Id" SelectedValue="{Binding SourceId, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditSelection}" MinHeight="34"
                          AutomationProperties.Name="Sumber audio Windows" />
                <TextBlock Text="{Binding SourceDescription}" Margin="0,8,0,0" Foreground="#526577" />
                <TextBlock Margin="0,8,0,0" Foreground="#755417"
                           Text="Sumber tetap dapat terdengar melalui playback asli Windows; aplikasi tidak mengirim audio kembali ke sumber. Hanya audio aplikasi yang diarahkan ke endpoint ini yang ditangkap. Audio berproteksi DRM dapat tidak tertangkap." />
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="2. Pilih perangkat pendengar dan atur volume" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding SelectionSummary}" Margin="0,0,0,10" FontWeight="SemiBold" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyDevicesMessage}" Foreground="#755417" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Devices}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanSelect}" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                      HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{Binding Name}" />
                                            </CheckBox>
                                            <TextBlock Grid.Row="1" Text="{Binding DeviceDescription}" Foreground="#526577" Margin="22,5,0,0" />
                                            <Grid Grid.Row="2" Margin="22,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Volume sumber dikelola Windows — bukan oleh slider aplikasi. Centang untuk menghitungnya sebagai satu pendengar."
                                                           Foreground="#146C94">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSource}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSource}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="65" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                            Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding CanAdjustVolume}" VerticalAlignment="Center"
                                                            AutomationProperties.Name="Volume perangkat pendengar" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding PlaybackDescription}" FontSize="12" Foreground="#526577" Margin="0,7,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </GroupBox>
        <Border Grid.Row="3" Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Mulai berbagi" Click="Start_Click" IsEnabled="{Binding CanStart}" />
                    <Button Content="Berhenti" Click="Stop_Click" IsEnabled="{Binding CanStop}" />
                    <Button Content="Segarkan perangkat" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" />
                    <TextBlock Text="{Binding RunState}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Level input" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding InputPeakPercent, Mode=OneWay}"
                                 Height="12" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding InputPeakPercent, StringFormat={}{0:0}%}" Margin="12,0,0,0" MinWidth="42" />
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" Foreground="#183B56" />
                <TextBlock Text="{Binding Notification}" Margin="0,5,0,0" Foreground="#9B401D" />
                <TextBlock Text="Putusnya satu output tidak menghentikan pendengar lain. Perangkat yang tersambung kembali tidak bergabung otomatis; berhenti dan pilih ulang. Perbedaan delay Bluetooth tidak dikalibrasi otomatis."
                           Margin="0,8,0,0" FontSize="12" Foreground="#526577" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
